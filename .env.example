# ============================================================
# Zite — Environment Variables (דוגמה, מלא ערכים אמיתיים בשרת)
# ============================================================

# Airtable
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# Server
PORT=4000
NODE_ENV=production

# Client (Vite — נטען ב-build time)
VITE_API_URL=

# Make webhooks — טריגר לאחר יצירת רשומת מסמך מוצלחת ב-/api/upload-document
# (ר' server/src/make-webhooks.js). אם חסר URL עבור טבלה מסוימת, ה-webhook
# מדלג בלי לשגר שגיאה — ההעלאה עצמה לא מושפעת.
MAKE_WEBHOOK_INCOME_INVOICE=
MAKE_WEBHOOK_EXPENSE_INVOICE=
MAKE_WEBHOOK_DELIVERY_NOTE=
MAKE_WEBHOOK_CHECK=
MAKE_WEBHOOK_SPRAY_REPORT=
